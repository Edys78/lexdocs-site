rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Contatos enviados por visitantes (incluindo subcoleções de arquivos)
    match /contatos/{contactId} {
      allow read, write: if true;
      
      match /{subcollection=**} {
        allow read, write: if true;
      }
    }
    
    // Solicitações de Análise e Documentos anexados
    match /solicitacoes_analise/{requestId} {
      allow read, write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }
    
    // Rastreamento de cliques em canais de contato
    match /interacoes_cliques/{clickId} {
      allow read, write: if true;
    }
  }
}
